# ============ 大模型(OpenAI 兼容协议,默认指向 DeepSeek) ============
DEEPSEEK_API_KEY=sk-你的密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=1.0

# 没有 API Key 时置为 true,进入离线演示模式(返回模拟回答,便于跑通链路)
MOCK_LLM=false

# ============ 向量化后端 ============
# hash = 本地稀疏向量(离线可用,默认);api = 调用外部 embedding 模型
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=4096
# 当 EMBEDDING_BACKEND=api 时需要下面三项
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ============ 检索与切分参数 ============
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=4
SCORE_THRESHOLD=0.10
HISTORY_ROUNDS=10

# ============ 存储与前端 ============
DATA_DIR=./data
API_BASE=http://127.0.0.1:8000